# GEMINI_API_KEY: Required for Gemini AI API calls (server-side).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Optional for static client-side hosting (e.g. GitHub Pages).
# Set this in your GitHub Repository Secrets & Actions workflow if hosting statically.
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
